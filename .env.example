SPRING_PROFILES_ACTIVE=dev
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200
APP_VERSION=0.1.0
# Required for direct bootRun; start:dev supplies an authenticated Dev URI.
# FIRESTORE_MONGODB_URI=mongodb://localhost:27017/dev1
FIREBASE_PROJECT_ID=lost-key-finder-dev
# Firebase Console > Project settings > Your apps > Web app SDK configuration
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=lost-key-finder-dev.firebaseapp.com
# FIREBASE_APP_ID=
# Required for direct bootRun; start:dev reads this from Secret Manager.
# PUBLIC_RATE_LIMIT_HMAC_KEY=<base64-encoded random key, at least 32 bytes>
