{
  "name": "@lost-key-finder/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "./gradlew bootJar",
    "start": "./gradlew bootRun",
    "start:dev": "npm run firestore:start",
    "lint": "./gradlew ktlintCheck",
    "test": "./gradlew test jacocoTestCoverageVerification",
    "test:http": "./gradlew httpTest",
    "test:integration": "./gradlew integrationTest",
    "test:coverage": "./gradlew jacocoTestReport",
    "firestore:verify": "node scripts/firestore-dev.mjs verify",
    "firestore:start": "node scripts/firestore-dev.mjs start",
    "openapi": "./gradlew exportOpenApi",
    "generate:client": "npm run openapi && tsx scripts/generate-client.ts"
  },
  "devDependencies": {
    "ng-openapi-gen": "1.0.5",
    "tsx": "^4.20.5"
  }
}
